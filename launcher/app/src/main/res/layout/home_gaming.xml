<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gamingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gaming_root_scrim"
    android:orientation="vertical"
    android:paddingStart="44dp"
    android:paddingTop="24dp"
    android:paddingEnd="44dp"
    android:paddingBottom="18dp">

    <!-- Top bar: bold uppercase MODO JUEGO on left, live weather + clock on right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/gamingHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:includeFontPadding="false"
            android:letterSpacing="0.03"
            android:singleLine="true"
            android:text="@string/home_theme_gaming"
            android:textAllCaps="true"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/gamingWeatherRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.gathin.tvhome.WeatherIconView
                android:id="@+id/gamingWeatherIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/gamingWeatherText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@string/font_medium"
                android:maxWidth="300dp"
                android:singleLine="true"
                android:textColor="#CCFFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <TextClock
            android:id="@+id/gamingClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@string/font_medium"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="#F2FFFFFF"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- Main split body: 36% left vertical card list, 64% right giant spotlight panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <ScrollView
            android:id="@+id/gamingScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="18dp"
            android:layout_weight="36"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fadingEdgeLength="16dp"
            android:focusable="false"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/gamingList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <FrameLayout
            android:id="@+id/gamingSpotlight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="64"
            android:background="@drawable/gaming_spotlight_bg"
            android:focusable="false">

            <ImageView
                android:id="@+id/gamingSpotlightBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/gamingSpotlightIcon"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center"
                android:layout_marginBottom="44dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_gravity="bottom"
                android:background="@drawable/gaming_spotlight_scrim"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/gamingSpotlightTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="2"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/gaming_ok_badge"
                        android:fontFamily="@string/font_medium"
                        android:paddingStart="11dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="11dp"
                        android:paddingBottom="3dp"
                        android:text="OK"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/gamingSpotlightHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:ellipsize="end"
                        android:fontFamily="@string/font_regular"
                        android:singleLine="true"
                        android:text="@string/library_open"
                        android:textColor="#D9FFFFFF"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gaming_spotlight_border"
                android:importantForAccessibility="no" />
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom hairline divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#26FFFFFF"
        android:importantForAccessibility="no" />

    <!-- Bottom status & action bar -->
    <LinearLayout
        android:id="@+id/gamingBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="10dp">

        <LinearLayout
            android:id="@+id/gamingBtnInputs"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/gaming_bottom_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:nextFocusLeft="@id/gamingBtnInputs"
            android:nextFocusRight="@id/gamingBtnWifi"
            android:nextFocusDown="@id/gamingBtnInputs"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_input" />

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="#33FFFFFF"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:singleLine="true"
                android:text="@string/inputs"
                android:textAllCaps="true"
                android:textColor="#F2FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/gamingBtnWifi"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/gaming_bottom_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:nextFocusLeft="@id/gamingBtnInputs"
            android:nextFocusRight="@id/gamingBtnSettings"
            android:nextFocusDown="@id/gamingBtnWifi"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wifi" />

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="#33FFFFFF"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/gamingWifiText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-condensed"
                android:maxWidth="240dp"
                android:singleLine="true"
                android:text="@string/wifi"
                android:textAllCaps="true"
                android:textColor="#F2FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/gamingBtnSettings"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/gaming_bottom_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:nextFocusLeft="@id/gamingBtnWifi"
            android:nextFocusRight="@id/gamingBtnSettings"
            android:nextFocusDown="@id/gamingBtnSettings"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_settings" />

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="#33FFFFFF"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:singleLine="true"
                android:text="@string/settings"
                android:textAllCaps="true"
                android:textColor="#F2FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
